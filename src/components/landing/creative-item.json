{
  "collectionName": "components_landing_creative_items",
  "info": {
    "displayName": "Creative showcase item",
    "icon": "play"
  },
  "options": {},
  "attributes": {
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "title": {
      "type": "string",
      "required": true
    },
    "developer": {
      "type": "string",
      "required": true
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["videos"]
    },
    "text": {
      "type": "text",
      "required": true
    },
    "audienceKey": {
      "type": "enumeration",
      "enum": ["apps", "games"],
      "default": "games",
      "description": "Which landing hero-toggle audience this Creative Services video shows under (apps vs games). Mirrors Hero audience audienceKey."
    }
  }
}
